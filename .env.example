
# Copycat root configuration reference
# Copy the relevant service-specific example file instead of using this file
# directly in production.

# Public frontend configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SNAPSHOT_BASE_URL=http://localhost:3000/copycat-data

# Cloudflare R2 publisher configuration
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=copycat-snapshots
R2_PUBLIC_URL=replace_me

# Local publisher controls
PUBLISH_INTERVAL_SECONDS=60
COPYCAT_MAX_WALLETS=50
FILL_LOOKBACK_MINUTES=60
REQUEST_TIMEOUT_SECONDS=20
LOCAL_ONLY=true
NO_UPLOAD=true
