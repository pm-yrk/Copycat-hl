# Copy this file to publisher.env and fill in the values.
# Do not commit publisher.env to GitHub.

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=copycat-snapshots
R2_PUBLIC_URL=https://pub-b9e0279f5eb0496b99c7fa37329e6b53.r2.dev

# R2 endpoint is usually this. If you set R2_ACCOUNT_ID, the script can also build it automatically.
# R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

PUBLISH_INTERVAL_SECONDS=60
COPYCAT_MAX_WALLETS=50
FILL_LOOKBACK_MINUTES=60
REQUEST_TIMEOUT_SECONDS=20

# For testing without uploading to R2, set LOCAL_ONLY=true.
LOCAL_ONLY=false
