# Copy this file to publisher.env and fill in the values.
# Do not commit publisher.env to GitHub.

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=copycat-snapshots
R2_PUBLIC_URL=https://pub-b9e0279f5eb0496b99c7fa37329e6b53.r2.dev

# R2 endpoint is usually this. If you set R2_ACCOUNT_ID, the script can also build it automatically.
# R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

PUBLISH_INTERVAL_SECONDS=60
COPYCAT_MAX_WALLETS=50
FILL_LOOKBACK_MINUTES=60
REQUEST_TIMEOUT_SECONDS=20
R2_UPLOAD_RETRIES=3

# Chart history and index state are stored automatically under
# C:\CopycatPersistentState on Windows so Git updates cannot erase them.
# COPYCAT_POSITION_HISTORY_DIR=C:\CopycatPersistentState\position_history

# For testing without uploading to R2, set LOCAL_ONLY=true.
LOCAL_ONLY=false

# Telegram intelligence alerts.
# The bot checks every 5 minutes, sends one brief per hour, and only sends
# separate alerts when a meaningful data/news/catalyst trigger is met.
COPYCAT_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
COPYCAT_TELEGRAM_CHAT_ID=your_telegram_chat_id
COPYCAT_TELEGRAM_BRIEF_INTERVAL_MINUTES=60
COPYCAT_TELEGRAM_FLOW_MIN_NET_BUYERS=5
COPYCAT_TELEGRAM_FLOW_MIN_NET_VALUE_USD=1000000
COPYCAT_TELEGRAM_SIGNAL_SHIFT=0.20
COPYCAT_TELEGRAM_MIN_SIGNAL_GROSS_USD=500000
COPYCAT_TELEGRAM_ALLOCATION_SHIFT=0.03
COPYCAT_TELEGRAM_LARGE_ORDER_USD=250000
COPYCAT_TELEGRAM_EVENT_COOLDOWN_MINUTES=60
COPYCAT_TELEGRAM_NEWS_MIN_RELEVANCE=20
COPYCAT_TELEGRAM_MAX_TRIGGER_ALERTS=4
COPYCAT_TELEGRAM_STALE_MINUTES=10
